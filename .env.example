# ---------------------------------------------------------------------------
# CommercePilot AI — environment template
#
# Copy to .env and fill in only what you need:  cp .env.example .env
# .env is git-ignored. NEVER commit real keys.
#
# The app starts and works with an empty file. Missing optional values simply
# switch a feature to its clearly-labelled fallback mode.
# ---------------------------------------------------------------------------

# --- AI provider (optional) -------------------------------------------------
# Any OpenAI-compatible endpoint works. Groq's free tier is the default:
# strict JSON output and no training on inference data.
# Without a key the app runs deterministic templates and reports
# llm_mode=fallback at /api/health.
LLM_API_KEY=
LLM_PROVIDER=groq
# Optional custom endpoint, e.g. a local Ollama server: http://127.0.0.1:11434/v1
LLM_BASE_URL=

# Cheap model used for every task (intent parsing, short generations).
LLM_MODEL=openai/gpt-oss-20b
# Stronger model used ONLY for storefront and ad copy. Leave blank to use the
# cheap model everywhere (the lowest-cost configuration).
LLM_MODEL_STRONG=

LLM_TIMEOUT=20
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800

# Hard monthly spend cap in USD, estimated from token counts. 0 disables it.
AI_MONTHLY_CAP_USD=25
# Log a warning once this percentage of the cap has been used.
AI_BUDGET_WARN_PCT=80

# --- Live web search (optional) --------------------------------------------
# Key-free DuckDuckGo search is used when no Serper key is present.
SERPER_API_KEY=
WEB_SEARCH_TIMEOUT=8

# --- Optional integrations (server-side only) ------------------------------
# Campaigns always stay local drafts; nothing is auto-published.
# Credentials can also be entered in the Settings tab, which stores them in
# .secrets/ (git-ignored) instead of environment variables.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# --- Storage ----------------------------------------------------------------
# SQLite file holding projects and the AI usage log.
# Default: data/commercepilot.sqlite3
# DB_PATH=/data/commercepilot.sqlite3

# --- Server -----------------------------------------------------------------
# Backend bind address. Hosts such as Render/Vercel provide PORT themselves.
# HOST=0.0.0.0
# PORT=8000

# The frontend build can point at a separate API origin (no trailing slash).
# Leave empty for same-origin deployments and for local development.
# VITE_API_BASE_URL=https://api.your-app.example.com

# Only needed when the UI is served from a different origin than the API.
# CORS_ORIGINS=https://your-app.example.com
