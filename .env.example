# Never commit .env or actual credentials.
APP_MODE=production
PUBLIC_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=
# Select a model available in your provider account.
LLM_MODEL=openai/gpt-oss-20b
LLM_MODEL_STRONG=
LLM_TIMEOUT=20
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1600
# Estimated guard only; enforce actual billing limits in the provider dashboard.
AI_MONTHLY_CAP_USD=25
AI_BUDGET_WARN_PCT=80
SERPER_API_KEY=
WEB_SEARCH_TIMEOUT=8

# Set these to a persistent local volume in deployment.
# DB_PATH=/data/commercepilot.sqlite3
# SECRETS_DIR=/data/secrets
# On Vercel use a managed PostgreSQL URL (including its TLS parameters).
DATABASE_URL=
# Required to save Shopify/Meta credentials in PostgreSQL. Keep this key stable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Customer support uses the same configured LLM and workspace database.
# Grant read_products and read_legal_policies on the Shopify Admin token.
SUPPORT_KNOWLEDGE_HOURS=24
SUPPORT_DAILY_MESSAGES=300
ADVISOR_DAILY_MESSAGES=200
HOST=0.0.0.0
PORT=8000
