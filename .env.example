# ---------------------------------------------------------------------------
# CommercePilot AI - environment template. Copy to .env and fill in values.
# NEVER commit real keys. .env is git-ignored.
# ---------------------------------------------------------------------------

# --- Optional LLM (OpenAI-compatible). If unset, the app runs in
# --- FALLBACK MODE: deterministic parsing + templates (clearly labelled).
OPENAI_API_KEY=
# Optional custom base URL (e.g. a local Ollama OpenAI-compatible endpoint
# such as http://127.0.0.1:11434/v1). Leave blank for api.openai.com.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Optional live web search (Product Hunter Mode A).
# ddgs (DuckDuckGo) works with no key. If you have a Serper key it is used instead.
SERPER_API_KEY=

# --- Optional Meta Marketing API (NOT connected by default).
# Server-side only. Never expose these in the frontend.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# --- Optional Shopify Admin API (NOT connected by default). Server-side only.
# Note: a Storefront API token does NOT grant admin access.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# --- Backend server
# Local defaults below. On Render the platform sets PORT itself and the service
# binds 0.0.0.0 automatically - you do NOT need to set BACKEND_HOST/PORT there.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma separated list of allowed frontend origins for CORS.
# PRODUCTION: set this to your deployed frontend origin(s), e.g.
#   CORS_ORIGINS=https://commercepilot-ai.vercel.app
# Never use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Storage ---
# SQLite file location. Default: backend/commercepilot.sqlite3 (fine locally).
# On a host with an ephemeral disk, mount a persistent disk and point DB_PATH
# at it, e.g. DB_PATH=/data/commercepilot.sqlite3
DB_PATH=

# Search timeouts (seconds)
WEB_SEARCH_TIMEOUT=8

# --------------------------------------------------------------------------- #
# Frontend (Vite) - set these in the Vercel project, NOT in the backend .env.
# They are inlined into the browser bundle at build time.
# --------------------------------------------------------------------------- #
# Deployed backend origin, no trailing slash, e.g.
#   VITE_API_BASE_URL=https://commercepilot-ai.onrender.com
# Leave EMPTY for local development (Vite proxies /api to 127.0.0.1:8000).
VITE_API_BASE_URL=
