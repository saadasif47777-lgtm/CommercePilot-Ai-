# Never commit .env or actual credentials.
APP_MODE=production
ADMIN_USERNAME=admin
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=
PUBLIC_URL=https://your-host.example
CORS_ORIGINS=https://your-host.example

LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=
# Select a model available in your provider account.
LLM_MODEL=openai/gpt-oss-20b
LLM_MODEL_STRONG=
LLM_TIMEOUT=20
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1600
# Estimated guard only; enforce actual billing limits in the provider dashboard.
AI_MONTHLY_CAP_USD=25
AI_BUDGET_WARN_PCT=80
SERPER_API_KEY=
WEB_SEARCH_TIMEOUT=8

# Set these to a persistent local volume in deployment.
# DB_PATH=/data/commercepilot.sqlite3
# SECRETS_DIR=/data/secrets
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
HOST=0.0.0.0
PORT=8000
